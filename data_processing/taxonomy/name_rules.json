{
  "taxonomy_version": "1.2",
  "_comment": "Used only when a store's own category gives no product type. Rules run in order; the first match wins, so specific rules come first. Patterns are case-insensitive. Names matching not_the_product are parts or add-ons and get no type.",
  "not_the_product": "\\b(covers?|bracket|adapter|adaptor|cables?|chargers?|filter (cartridge|candle)s?|cartridges?|spare|replacement|bag|sleeve|protector|screen guard|strap|colorfilm|fun pack|toner|hose|duct|holder|hub|cleaning kit|rotary support)\\b",
  "rules": [
    {
      "product_type": "Laptop",
      "pattern": "\\b(laptop|macbook|vivobook|ideapad)\\b"
    },
    {
      "product_type": "Desktop Computer",
      "pattern": "\\b(desktop|mac mini|ideacentre)\\b"
    },
    {
      "product_type": "Printer",
      "pattern": "\\bprinter\\b"
    },
    {
      "product_type": "Monitor",
      "pattern": "\\bmonitor\\b"
    },
    {
      "product_type": "Projector",
      "pattern": "\\bprojector\\b"
    },
    {
      "product_type": "Earbuds",
      "pattern": "\\b(earbuds?|earpods|tws|airpods|buds\\d?)\\b"
    },
    {
      "product_type": "Headphones",
      "pattern": "\\b(head ?phones?|headsets?|neckband|earphones?)\\b"
    },
    {
      "product_type": "Power Bank",
      "pattern": "\\bpower ?banks?\\b"
    },
    {
      "product_type": "Flash Drive",
