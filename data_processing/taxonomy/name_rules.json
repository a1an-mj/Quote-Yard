    },
    {
      "product_type": "Memory Card",
      "pattern": "\\b(memory card|micro ?sd|sd card)\\b"
    },
    {
      "product_type": "Hard Drive",
      "pattern": "\\b(hard (disk|drive)|external (ssd|hdd))\\b"
    },
    {
      "product_type": "Mouse & Keyboard",
