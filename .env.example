# Quote Yard settings. Copy to .env on the server and fill in; .env is not in git.
QUOTE_YARD_DATABASE_URL=postgresql+psycopg:///quote_yard
QUOTE_YARD_CORS_ORIGINS=http://localhost:5173
QUOTE_YARD_RATE_LIMIT=120
QUOTE_YARD_AUTH_RATE_LIMIT=20
QUOTE_YARD_COOKIE_SECURE=true

# console prints codes in the terminal (development); smtp sends real email.
QUOTE_YARD_MAIL_BACKEND=console
# QUOTE_YARD_SMTP_HOST=smtp.gmail.com
# QUOTE_YARD_SMTP_PORT=587
# QUOTE_YARD_SMTP_USER=your.address@gmail.com
# QUOTE_YARD_SMTP_PASSWORD=your-app-password
# QUOTE_YARD_SMTP_FROM=your.address@gmail.com
